# Create a 32-80 character token containing only:
# letters, numbers, underscores, and hyphens.
# Run: python scripts/generate_verification_token.py
EBAY_VERIFICATION_TOKEN=replace_with_generated_token

# IMPORTANT:
# This must exactly match the HTTPS URL you enter in the eBay Developer Portal.
# Do not add/remove a trailing slash in one place but not the other.
EBAY_NOTIFICATION_ENDPOINT_URL=https://your-public-host.example.com/ebay/account-deletion

LOG_LEVEL=INFO
