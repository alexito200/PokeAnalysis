# eBay Marketplace Account Deletion verification
EBAY_VERIFICATION_TOKEN=replace_with_generated_token
EBAY_NOTIFICATION_ENDPOINT_URL=https://your-public-host.example.com/ebay/account-deletion

# eBay Production OAuth credentials
# Use the Production App ID as EBAY_CLIENT_ID.
# Use the Production Cert ID as EBAY_CLIENT_SECRET.
EBAY_CLIENT_ID=replace_with_production_app_id
EBAY_CLIENT_SECRET=replace_with_production_cert_id

# Protects the OAuth test endpoint so anonymous users cannot mint tokens.
# Generate a long random value and store it only in Render/local .env.
POKEANALYSIS_ADMIN_KEY=replace_with_long_random_admin_key

LOG_LEVEL=INFO
